# ============================================================
# SALUTAR — Canal de Registro de Denúncia
# Variáveis de ambiente — copie para .env e preencha os valores
# ============================================================

# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salutar_db
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# JWT — use uma chave forte com mínimo 32 caracteres
# Expiração de 15 minutos conforme especificação de segurança
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_min_32_caracteres
JWT_EXPIRES_IN=15m

# Upload de Arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# URL de produção
FRONTEND_URL=https://www.salutar.com.br

# CORS — em produção, restringir ao domínio oficial
# Desenvolvimento: http://localhost:8080 ou http://localhost:5173
CORS_ORIGIN=https://www.salutar.com.br
